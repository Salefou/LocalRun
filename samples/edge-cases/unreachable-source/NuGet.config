<?xml version="1.0" encoding="utf-8"?>
<!-- On purpose: a source that can't be reached (.invalid never resolves), so `lrun build` can't query it for the latest
     versions; NuGet gives up after a few seconds of retries. Added to the sources of samples/NuGet.config, for the
     projects under this folder only. -->
<configuration>
  <packageSources>
    <add key="unreachable" value="http://lrun-samples.invalid/v3/index.json" />
  </packageSources>
</configuration>
