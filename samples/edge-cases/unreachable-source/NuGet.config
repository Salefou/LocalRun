<?xml version="1.0" encoding="utf-8"?>
<!-- On purpose: two sources `lrun build` can't query for the latest versions. One can't be reached (.invalid never
     resolves; NuGet gives up after a few seconds of retries), the other is a local folder that doesn't exist (NuGet
     itself would read it as an empty feed). Added to the sources of samples/NuGet.config, for the projects under this
     folder only. -->
<configuration>
  <packageSources>
    <add key="unreachable" value="http://lrun-samples.invalid/v3/index.json" />
    <add key="missing-folder" value="no-such-feed" />
  </packageSources>
</configuration>
