<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the sample workspace self-contained: packages are packed into ./.feed and cached in ./.packages,
     so hand testing never touches ~/.nuget/packages. reset.ps1 deletes both. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <add key="lrun-samples" value=".feed" />
  </packageSources>
</configuration>
