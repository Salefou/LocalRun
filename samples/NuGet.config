<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the sample workspace self-contained: packages are packed into ./.feed and cached in ./.packages,
     so hand testing never touches ~/.nuget/packages. reset.cmd empties both.
     <clear /> drops the user/machine sources: the samples reference each other with floating `*-*`
     versions, so LrSample.* packages left in another local feed (e.g. ~/.localnuget) would win. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="lrun-samples" value=".feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
