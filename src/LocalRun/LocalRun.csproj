<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<ConsoleOutputEncoding>utf-8</ConsoleOutputEncoding>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Installable as a .NET tool: pack it, then install the package with 'dotnet tool install' -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>lrun</ToolCommandName>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LocalRun.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibGit2Sharp" Version="0.31.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
		<PackageReference Include="NuGet.Configuration" Version="7.9.0" />
		<PackageReference Include="NuGet.Protocol" Version="7.9.0" />
		<PackageReference Include="NuGet.Versioning" Version="7.9.0" />
		<PackageReference Include="Rubjerg.Graphviz" Version="3.0.5" />
	</ItemGroup>

</Project>
