<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<ConsoleOutputEncoding>utf-8</ConsoleOutputEncoding>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Installable as a .NET tool: pack it, then install the package with 'dotnet tool install' -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>lrun</ToolCommandName>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The next version to release: the release workflow requires the pushed tag to match it, and after a
		     release it is bumped right away, so local builds (VersionPrefix-local-...) sort above the release -->
		<VersionPrefix>0.2.2</VersionPrefix>
		<PackageId>LocalRun</PackageId>
		<Authors>Salefou</Authors>
		<Description>Try a library change in the services that consume it as a NuGet package, across repositories: lrun scans them, builds the project dependency graph, repacks the libraries in between into a local feed in dependency order, and runs the executables side by side.</Description>
		<PackageTags>dotnet-tool;nuget;local-feed;multi-repo;dependency-graph;repack</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Salefou/LocalRun</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Salefou/LocalRun</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>https://github.com/Salefou/LocalRun/blob/master/CHANGELOG.md</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="PACKAGE.md" Pack="true" PackagePath="\" />
		<None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- The page template of 'plot' with the html flag; the graph data is filled in at run time -->
		<EmbeddedResource Include="Core\Modules\GraphPage.html" LogicalName="LocalRun.Core.Modules.GraphPage.html" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LocalRun.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibGit2Sharp" Version="0.31.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
		<PackageReference Include="NuGet.Configuration" Version="7.9.0" />
		<PackageReference Include="NuGet.Protocol" Version="7.9.0" />
		<PackageReference Include="NuGet.Versioning" Version="7.9.0" />
		<PackageReference Include="Rubjerg.Graphviz" Version="3.0.5" />
	</ItemGroup>

</Project>
