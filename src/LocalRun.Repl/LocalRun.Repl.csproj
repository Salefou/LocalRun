<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Installed with scripts/install-tools.ps1 -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>lrun-repl</ToolCommandName>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LocalRun.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LocalRun\LocalRun.csproj" />
	</ItemGroup>

</Project>
