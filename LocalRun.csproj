<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<ConsoleOutputEncoding>utf-8</ConsoleOutputEncoding>
	</PropertyGroup>

	<ItemGroup>
		<!-- The test project lives under the repo root; keep it out of this project's default globs. -->
		<Compile Remove="LocalRun.Tests\**" />
		<None Remove="LocalRun.Tests\**" />
		<EmbeddedResource Remove="LocalRun.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LocalRun.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibGit2Sharp" Version="0.31.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
		<PackageReference Include="NuGet.Configuration" Version="6.14.0" />
		<PackageReference Include="NuGet.Protocol" Version="6.14.0" />
		<PackageReference Include="NuGet.Versioning" Version="6.14.0" />
	</ItemGroup>

	<ProjectExtensions><VisualStudio><UserProperties output_4repack_1config_1json__JsonSchema="https://api.app-prg1.zerops.io/api/rest/public/settings/zerops-yml-json-schema.json" /></VisualStudio></ProjectExtensions>

</Project>
